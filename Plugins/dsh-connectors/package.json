{
  "name": "@gabrielbav/dsh-connectors",
  "version": "0.2.2",
  "description": "Connectors for DeepSeek Harness: a Connectors page in Settings that connects remote MCP servers such as Granola (OAuth) and GitHub (personal access token)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrielbav/dsh-connectors.git"
  },
  "homepage": "https://github.com/gabrielbav/dsh-connectors#readme",
  "bugs": {
    "url": "https://github.com/gabrielbav/dsh-connectors/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "mcp",
    "connectors",
    "oauth",
    "granola",
    "linear",
    "jira",
    "confluence",
    "trello",
    "github",
    "gitlab",
    "azure-devops"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/host/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.json && tsdown && node scripts/wrap-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  }
}
