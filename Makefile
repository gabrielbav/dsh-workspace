# dsh-workspace: build the fork (local/daily) and the plugins, and boot dsh in different setups.
# Each setup is its own profile under $DSH_HOME/profiles, created on first use and managed only here.
# Sessions and credentials live in $DSH_HOME and are shared by every profile.
# Nothing here writes into the fork's files; run `make help` for the targets.
SHELL := bash
.DEFAULT_GOAL := help

ROOT     := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
FORK     := $(ROOT)/Fork/deepseek-harness
DSH_HOME ?= $(HOME)/.dsh
export DSH_HOME

# dsh-code runs workspaces in the dedicated Colima VM "dsh" (Docker + gVisor runsc); `make docker` starts it.
COLIMA_PROFILE ?= dsh
DOCKER_HOST    ?= unix://$(HOME)/.colima/$(COLIMA_PROFILE)/docker.sock
export DOCKER_HOST
WORKER_IMAGE   := dsh-code-worker:0.3.0

FORK_PNPM   := corepack pnpm
PLUGIN_PNPM ?= corepack pnpm@11.28.5
# dsh's plugin manager runs the `pnpm` on PATH. The global one (Homebrew 9.x) refuses `add` in a profile
# workspace (ERR_PNPM_ADDING_TO_ROOT), so dsh started here gets a shim that runs the harness's pnpm version.
PNPM_SHIM   := $(ROOT)/Fork/.bin/pnpm
DSH         := cd "$(FORK)" && PATH="$(dir $(PNPM_SHIM)):$$PATH" node --import tsx/esm apps/cli/src/bin.ts
ARGS        ?=
P           ?=

# Plugin registry: short name -> repo (built there), package dir (linked into profiles) and the fork
# hook branches it needs. Booting a plugin fails unless local/daily carries every one of its hooks.
PLUGINS := airlock session-delete code connectors aws
repo_airlock        := $(ROOT)/Plugins/dsh-plugin-airlock
pkg_airlock         := $(repo_airlock)
hooks_airlock       :=
repo_session-delete := $(ROOT)/Plugins/dsh-plugin-session-delete
pkg_session-delete  := $(repo_session-delete)
hooks_session-delete := feat/session-controller-release-agent
repo_code           := $(ROOT)/Plugins/dsh-code
pkg_code            := $(repo_code)/packages/dsh-code
hooks_code          := feat/sidebar-mode-session-filter
repo_connectors     := $(ROOT)/Plugins/dsh-connectors
pkg_connectors      := $(repo_connectors)
hooks_connectors    :=
repo_aws            := $(ROOT)/Plugins/dsh-plugin-aws
pkg_aws             := $(repo_aws)
hooks_aws           :=

# The fork submodule runs on local/daily (local only), but this repo records master. `ignore = all` does not
# stop `git add -A` from recording local/daily, so keep the gitlink out of `git add` with skip-worktree.
PIN_GUARD := git -C "$(ROOT)" update-index --skip-worktree Fork/deepseek-harness 2>/dev/null || true

# Commit of local/daily that `make build` last built; kept outside the fork.
BUILD_STAMP := $(ROOT)/Fork/.built-commit

empty :=
space := $(empty) $(empty)
selected     = $(sort $(P))
unknown      = $(filter-out $(PLUGINS),$(selected))
combo_name   = dsh-$(subst $(space),-,$(selected))
build_target = $(if $(P),$(selected),$(PLUGINS))

# $(call boot,<profile>,<plugin short names>): create the profile from the web template if missing,
# link any plugin it lacks, then boot it. ARGS go to the web app (for example ARGS='--no-open --port 3081').
define boot
	@set -e; $(PIN_GUARD); $(MAKE) -s "$(PNPM_SHIM)"; dir="$(DSH_HOME)/profiles/$(1)"; git="git -C $(FORK)"; \
	[ "$$($$git branch --show-current)" = local/daily ] || { echo "the fork is not on local/daily; run: git -C Fork/deepseek-harness checkout local/daily && make build" >&2; exit 1; }; \
	$(foreach p,$(2),$(foreach h,$(hooks_$(p)), \
	  $$git rev-parse -q --verify "refs/heads/$(h)" >/dev/null || { echo "plugin $(p) needs fork branch $(h), which does not exist (see CLAUDE.md, fork branch model)" >&2; exit 1; }; \
	  ! $$git cherry local/daily $(h) $$($$git merge-base local/daily $(h)) | grep -q '^+' || { echo "plugin $(p) needs $(h), which local/daily does not include; run: make sync" >&2; exit 1; };)) \
	[ "$$(cat "$(BUILD_STAMP)" 2>/dev/null)" = "$$($$git rev-parse HEAD)" ] || { echo "the fork build is older than local/daily (or was never stamped); run: make build" >&2; exit 1; }; \
	$(foreach p,$(2),[ -d "$(pkg_$(p))/lib" ] || { echo "plugin $(p) is not built; run: make plugins P=$(p)" >&2; exit 1; };) \
	$(if $(filter code,$(2)),docker image inspect $(WORKER_IMAGE) >/dev/null 2>&1 || echo "warning: Docker at $(DOCKER_HOST) is down or lacks $(WORKER_IMAGE); Code stays disabled. Run: make docker" >&2;) \
	if [ ! -f "$$dir/package.json" ]; then \
	  echo "==> creating profile $(1)"; \
	  $(DSH) --profile $(1) --from-default-profile web --dump-config >/dev/null; \
	fi; \
	$(foreach p,$(2),grep -q '"link:$(pkg_$(p))"' "$$dir/package.json" || { echo "==> linking $(p) into $(1)"; ( $(DSH) plugin --profile $(1) add -w "link:$(pkg_$(p))" ); };) \
	echo "==> booting $(1)$(if $(2), with: $(2), with no plugins)"; \
	$(DSH) --profile $(1) $(ARGS)
endef

$(PNPM_SHIM):
	@mkdir -p "$(@D)"
	@printf '#!/bin/sh\n# Generated by DSH/Makefile: the pnpm version the harness is built with.\nexec corepack pnpm@11.28.5 "$$@"\n' > "$@"
	@chmod +x "$@"

.PHONY: help bootstrap setup install build check sync plugins docker docker-stop start-pure start-all start start-web profiles reset status

help:
	@echo "Setup and updates"
	@echo "  make bootstrap        fresh clone: fetch the fork, build local/daily without pushing, then setup"
	@echo "  make setup            build the harness and every plugin (first run, or after pulling)"
	@echo "  make build            pnpm install + build:artifacts in the fork (run on local/daily)"
	@echo "  make check            build:check in the fork"
	@echo "  make sync             sync master/feat/*/local/daily with upstream (Fork/sync.sh), then build"
	@echo "                        BASE=dsh-v0.2.2 to sit on a release tag, PUSH=0 to skip pushing"
	@echo "                        contributors: make sync PUSH=0 BASE=origin/master (the maintainer's last sync)"
	@echo "  make plugins          install + build every plugin (P=\"airlock code\" for some)"
	@echo "  make docker           start the Colima VM $(COLIMA_PROFILE) (gVisor) and build the dsh-code worker image"
	@echo "  make docker-stop      stop that VM"
	@echo ""
	@echo "Run dsh web (ARGS='--no-open --port 3081' is forwarded to the app)"
	@echo "  make start-pure       the fork with no plugins            (profile dsh-pure)"
	@echo "  make start-all        the fork with all plugins: $(PLUGINS)  (profile dsh-all)"
	@echo "  make start P=airlock  the fork with the listed plugins    (profile dsh-<names>)"
	@echo "  make start-web        your everyday web profile, unmanaged (profile web)"
	@echo ""
	@echo "Housekeeping"
	@echo "  make profiles         list profiles"
	@echo "  make reset            delete the generated dsh-* profiles (never web, never sessions)"
	@echo "  make status           branches and uncommitted changes of this repo and the fork"
	@echo ""
	@echo "Plugins: $(PLUGINS). DSH_HOME=$(DSH_HOME) (override for a scratch home)."

# Fresh clone: the fork needs a plain .git directory (a submodule clone keeps it under .git/modules with
# core.worktree, which the harness's lefthook postinstall refuses). Then stack the feat/* hooks into local/daily
# locally, then build everything. BASE=origin/master is the upstream commit the maintainer last synced, where
# every feat/* applies cleanly; PUSH=0 pushes nothing.
bootstrap:
	@set -e; url="$$(git -C "$(ROOT)" config -f .gitmodules submodule.Fork/deepseek-harness.url)"; \
	if [ ! -e "$(FORK)/.git" ]; then \
	  echo "==> cloning the fork into Fork/deepseek-harness"; git clone "$$url" "$(FORK)"; \
	elif [ -f "$(FORK)/.git" ]; then \
	  echo "==> moving the fork's git dir into Fork/deepseek-harness (the harness's postinstall refuses core.worktree)"; \
	  gd="$$(git -C "$(FORK)" rev-parse --absolute-git-dir)"; rm "$(FORK)/.git"; mv "$$gd" "$(FORK)/.git"; \
	  git config -f "$(FORK)/.git/config" --unset core.worktree; \
	fi
	@$(PIN_GUARD)
	PUSH=0 BASE=origin/master "$(ROOT)/Fork/sync.sh"
	$(MAKE) setup

setup: build plugins

install:
	cd "$(FORK)" && $(FORK_PNPM) install

build: install
	@$(PIN_GUARD)
	@branch="$$(git -C "$(FORK)" branch --show-current)"; \
	[ "$$branch" = local/daily ] || echo "warning: the fork is on $$branch, not local/daily; plugins that need the hooks may fail" >&2
	cd "$(FORK)" && $(FORK_PNPM) run build:artifacts
	git -C "$(FORK)" rev-parse HEAD > "$(BUILD_STAMP)"

check:
	cd "$(FORK)" && $(FORK_PNPM) run build:check

sync:
	"$(ROOT)/Fork/sync.sh"
	$(MAKE) build

plugins:
	@set -e; $(if $(filter-out $(PLUGINS),$(build_target)),echo "unknown plugin(s): $(filter-out $(PLUGINS),$(build_target)); known: $(PLUGINS)" >&2; exit 1;) \
	$(foreach p,$(build_target),echo "==> building $(p)"; ( cd "$(repo_$(p))" && $(PLUGIN_PNPM) install && $(PLUGIN_PNPM) run build );)

docker:
	colima start -p $(COLIMA_PROFILE) --activate=false
	@docker info --format '{{json .Runtimes}}' | grep -q '"runsc"' || { echo "runsc is not registered in Colima VM $(COLIMA_PROFILE); see CLAUDE.md (dsh-code)" >&2; exit 1; }
	docker build -q -t $(WORKER_IMAGE) "$(pkg_code)/worker"
	docker pull -q node:24-alpine

docker-stop:
	colima stop -p $(COLIMA_PROFILE)

start-pure:
	$(call boot,dsh-pure,)

start-all:
	$(call boot,dsh-all,$(PLUGINS))

start:
	@[ -n "$(P)" ] || { echo 'usage: make start P="airlock code"   (known: $(PLUGINS))' >&2; exit 1; }
	@[ -z "$(unknown)" ] || { echo "unknown plugin(s): $(unknown); known: $(PLUGINS)" >&2; exit 1; }
	$(call boot,$(combo_name),$(selected))

start-web: $(PNPM_SHIM)
	$(DSH) web $(ARGS)

profiles:
	@ls -1 "$(DSH_HOME)/profiles"

reset:
	@set -e; shopt -s nullglob; for d in "$(DSH_HOME)"/profiles/dsh-*/; do echo "removing $$d"; rm -rf "$$d"; done

status:
	@for repo in "$(ROOT)" "$(FORK)"; do \
	  name="$${repo#$(ROOT)}"; echo "== $${name#/}$${name:-dsh-workspace} [$$(git -C "$$repo" branch --show-current)]"; git -C "$$repo" status --short; \
	done
